# Development settings: copy to backend/.env.
# Values here override the repository root .env (used by docker compose), so supplier
# credentials can stay in the root .env.

APP_ENV=dev
# DATABASE_URL defaults to SQLite in backend/data/dev.db

# Dev catalog: up to N products with photos per category, in-stock first (~11.7k products for 10).
# 0 = the whole catalog (~390k products).
CATALOG_SAMPLE_PER_CATEGORY=10

# Admin account created on API start if it does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# b2b.i-t-p.pro (if not set in the root .env)
# SUPPLIER_LOGIN=
# SUPPLIER_PASSWORD=

# Photos are prefetched for the main image only; the rest of a gallery is processed when
# a product page is opened (a full gallery is ~5 photos per product, hours of downloading).
IMAGE_PREFETCH_GALLERY=false

# JWT_SECRET is optional in dev (a fixed dev secret is used); required in production.
