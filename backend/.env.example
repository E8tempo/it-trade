# Development settings: copy to backend/.env.
# Values here override the repository root .env (used by docker compose), so supplier
# credentials can stay in the root .env.

APP_ENV=dev
# DATABASE_URL defaults to SQLite in backend/data/dev.db

# Dev catalog sample: only products with photos, in-stock ones first. 0 = off (~390k products).
#   CATALOG_SAMPLE_LIMIT        - at most N products in total, spread over all root categories
#   CATALOG_SAMPLE_PER_CATEGORY - at most N products per category (10 gives ~11.7k products)
CATALOG_SAMPLE_LIMIT=200
CATALOG_SAMPLE_PER_CATEGORY=0

# Admin account created on API start if it does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# b2b.i-t-p.pro (if not set in the root .env)
# SUPPLIER_LOGIN=
# SUPPLIER_PASSWORD=

# Photos of out-of-stock products in advance too (otherwise on the first view). How many photos per
# product, how fast and whether at all is set in the admin panel, page "Загрузка каталога".
IMAGE_PREFETCH_OUT_OF_STOCK=true

# JWT_SECRET is optional in dev (a fixed dev secret is used); required in production.
