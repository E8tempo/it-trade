# Copy to .env and fill in. Only deployment-time settings live here; markups, contacts and
# other things the shop owner changes while the site runs are edited in the admin panel.

# Public domain. Caddy obtains a Let's Encrypt certificate for it automatically
# (DNS A record must point to this server, ports 80/443 open). Use "localhost" to try locally.
DOMAIN=shop.example.ru

# PostgreSQL. Use a URL-safe password, e.g. `openssl rand -hex 24`.
POSTGRES_DB=ittrade
POSTGRES_USER=ittrade
POSTGRES_PASSWORD=

# b2b.i-t-p.pro account used for the API (prices, stock, image lists)
SUPPLIER_LOGIN=
SUPPLIER_PASSWORD=
# Outgoing mail: the code that confirms a client's e-mail at registration. Port 465 = TLS, 587 = STARTTLS.
# Empty SMTP_HOST: letters are written to the API log instead (development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=                             # IT Trade <noreply@shop.example.ru>; SMTP_USER if empty
# Requisites by ИНН in the registration form (dadata.ru, free up to 10 000 lookups a day);
# empty: the client types the name and КПП by hand
DADATA_API_KEY=
# N in catalog_tree_N.json / products_N.json
SUPPLIER_PRICELIST=9

# Secret for signing JWT sessions: a random string of 32+ chars, e.g. `openssl rand -hex 32`.
# Changing it logs everybody out.
JWT_SECRET=

# Admin account, created on first start (later password changes are done in the app)
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=

# --- optional tuning -------------------------------------------------------------------
# TZ=Europe/Simferopol
# How often prices/stock and the catalog are synced, and photo loading (pause, photos per product,
# download speed) are set in the admin panel, page "Загрузка каталога"; a fresh install starts with
# photo loading paused.
# IMAGE_WORKERS=2                      # CPU processes for watermark removal (~1 s of CPU per photo):
#                                      # cores - 1, so the CPU keeps up with the downloads
# IMAGE_PREFETCH_OUT_OF_STOCK=false    # otherwise those photos are processed on first view
# WEB_CONCURRENCY=2                    # API processes; they share the downloads the worker leaves free
# JWT_ACCESS_TTL_MIN=15
# JWT_REFRESH_TTL_DAYS=30
