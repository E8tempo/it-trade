# Copy to .env and fill in. Only deployment-time settings live here; markups, contacts and
# other things the shop owner changes while the site runs are edited in the admin panel.

# Public domain. Caddy obtains a Let's Encrypt certificate for it automatically
# (DNS A record must point to this server, ports 80/443 open). Use "localhost" to try locally.
DOMAIN=shop.example.ru

# PostgreSQL. Use a URL-safe password, e.g. `openssl rand -hex 24`.
POSTGRES_DB=ittrade
POSTGRES_USER=ittrade
POSTGRES_PASSWORD=

# b2b.i-t-p.pro account used for the API (prices, stock, image lists)
SUPPLIER_LOGIN=
SUPPLIER_PASSWORD=
# N in catalog_tree_N.json / products_N.json
SUPPLIER_PRICELIST=9

# Secret for signing JWT sessions: a random string of 32+ chars, e.g. `openssl rand -hex 32`.
# Changing it logs everybody out.
JWT_SECRET=

# Admin account, created on first start (later password changes are done in the app)
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=

# --- optional tuning -------------------------------------------------------------------
# TZ=Europe/Simferopol
# CATALOG_SYNC_HOUR=5                  # nightly catalog sync, local time
# STOCK_SYNC_INTERVAL_MIN=30           # supplier limit: 10 requests/hour
# IMAGE_WORKERS=2                      # CPU processes for watermark removal
# IMAGE_DOWNLOAD_RPS=3                 # worker; supplier limit is 5/s in total
# IMAGE_ONDEMAND_RPS=0.75              # per API process
# IMAGE_PREFETCH_OUT_OF_STOCK=false    # otherwise those photos are processed on first view
# IMAGE_PREFETCH_GALLERY=true          # false: only main photos in advance, the rest on first view
# WEB_CONCURRENCY=2                    # API processes
# JWT_ACCESS_TTL_MIN=15
# JWT_REFRESH_TTL_DAYS=30
